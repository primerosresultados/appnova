generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id       String  @id @default(uuid())
  name     String
  logo     String?
  status   String  @default("ACTIVE") // ACTIVE, INACTIVE, LEAD
  website  String?
  industry String?
  email    String?
  phone    String?

  // Billing Info
  taxId          String?
  company        String?
  billingAddress String?
  billingEmail   String?
  paymentTerms   String? // e.g. "Net 30"

  projects Project[]

  financialRecords FinancialRecord[]
  clientNotes      ClientNote[]

  // Finance Relations
  contracts    Contract[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index([status])
}

model Project {
  id           String            @id @default(uuid())
  name         String
  code         String? // Custom project code/identifier (e.g., MO239)
  description  String?
  clientId     String
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status       String            @default("PLANNING") // PLANNING, IN_PROGRESS, REVIEW, COMPLETED, ON_HOLD
  priority     String            @default("MEDIUM") // LOW, MEDIUM, HIGH
  startDate    DateTime?
  dueDate      DateTime?
  budget       Float?
  
  // Meta (Facebook) Ad Account Integration
  metaAdAccountId   String? // Linked Meta ad account ID
  metaAdAccountName String? // Display name of the ad account
  
  tasks        Task[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  actionLogs   ActionLog[]
  workflows    ProjectWorkflow[]
  milestones   Milestone[]
  resources    Resource[]
  transactions Transaction[]
  contents     Content[]
  competitors  Competitor[]
  adReports    AdReport[]

  @@index([clientId])
  @@index([status])
  @@index([updatedAt])
  @@index([dueDate])
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  priority    String    @default("MEDIUM")
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id])
  links       String? // JSON string or comma separated URLs
  dueDate     DateTime?
  attachments String? // JSON string of file URLs

  actionLogs ActionLog[] // Task-specific logs (Bitácora)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

model ActionLog {
  id        String  @id @default(uuid())
  content   String
  type      String  @default("NOTE") // NOTE, TASK, MEETING, EMAIL, WARNING
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId    String? // Optional for now until Auth is fully rigorous, but UI will use it
  user      User?    @relation(fields: [userId], references: [id])
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  // Threaded replies
  parentId String?
  @@index([parentId])
  parent   ActionLog?  @relation("ActionLogReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ActionLog[] @relation("ActionLogReplies")

  // Social features
  mentions      UserMention[]
  reactions     ActionLogReaction[]
  notifications Notification[]

  @@index([projectId])
  @@index([taskId])
}

model Workflow {
  id          String  @id @default(uuid())
  name        String
  description String?
  category    String? // e.g., "Social Media", "SEO", "Web Dev"

  stages WorkflowStage[]

  projects ProjectWorkflow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowStage {
  id          String  @id @default(uuid())
  title       String
  description String?
  order       Int     @default(0)

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  tasks WorkflowTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowTask {
  id          String  @id @default(uuid())
  title       String
  description String?
  order       Int     @default(0)

  stageId String
  stage   WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectWorkflow {
  id         String   @id @default(uuid())
  projectId  String
  workflowId String
  status     String   @default("ACTIVE")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, workflowId])
}

enum Role {
  SUPERADMIN
  PROJECT_MANAGER
  COLABORADOR
  CLIENTE
}

model User {
  id              String      @id @default(uuid())
  name            String
  email           String      @unique
  avatar          String?
  role            Role        @default(COLABORADOR)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  actionLogs      ActionLog[]
  tasks           Task[]
  createdContents Content[]   @relation("ContentCreator")

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  pushSubscriptions PushSubscription[]
  votes             ResourceVote[]
  adReports         AdReport[]
  adReportComments  AdReportComment[]

  // Social features
  mentions      UserMention[]
  reactions     ActionLogReaction[]
  notifications Notification[]
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  keys      String // JSON string of { p256dh, auth }
  userId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Milestone {
  id          String   @id @default(uuid())
  title       String
  description String? // Rich text content
  date        DateTime
  mediaUrl    String? // URL for image or video (external)
  filePath    String? // Path for uploaded file
  type        String   @default("MILESTONE")
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([date])
}

model Resource {
  id            String   @id @default(uuid())
  name          String
  type          String // DRIVE, LINK, FILE, CREDENTIAL, IDEA
  url           String?
  content       String? // For credentials, notes
  justification String? // For Ideas: "Why is this a good idea?"
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  votes ResourceVote[]

  @@index([projectId])
}

model ResourceVote {
  id         String   @id @default(uuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([resourceId, userId])
  @@index([resourceId])
}

model FinancialRecord {
  id          String   @id @default(uuid())
  amount      Float
  type        String // PAYMENT, COMMITMENT, REFUND
  description String
  date        DateTime
  status      String // PENDING, COMPLETED, OVERDUE, FACTURA_EMITIDA, FACTURA_PAGADA, etc.

  // Invoice Details
  invoiceNumber String?
  dueDate       DateTime?
  paymentDate   DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([date])
}

model ClientNote {
  id          String  @id @default(uuid())
  content     String
  isImportant Boolean @default(false)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Finance Module
model Account {
  id       String @id @default(uuid())
  name     String // e.g., "Banco de Chile - Cta Cte", "Caja Chica"
  type     String // BANK, CASH, CREDIT
  balance  Float  @default(0)
  currency String @default("CLP")

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  type        String // INCOME, EXPENSE
  category    String // e.g., "Software", "Office", "Salaries", "Client Payment"
  description String?
  date        DateTime @default(now())
  status      String   @default("COMPLETED") // PENDING, COMPLETED, CANCELLED

  // Tax Handling (Chile)
  taxAmount Float?  @default(0) // IVA or Retention
  isTaxable Boolean @default(false)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Optional link to Client or Project
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([projectId])
  @@index([clientId])
  @@index([date])
}

model Contract {
  id          String  @id @default(uuid())
  title       String
  description String?
  amount      Float // Monthly or Total amount
  frequency   String? // MONTHLY, ONE_OFF, ANNUALLY

  startDate DateTime
  endDate   DateTime?
  status    String    @default("ACTIVE") // ACTIVE, EXPIRED, TERMINATED

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  attachments String? // JSON list of file URLs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([startDate])
}

model Content {
  id          String  @id @default(uuid())
  title       String
  type        String // SEO, INSTAGRAM_POST, INSTAGRAM_STORY, INSTAGRAM_REEL, FACEBOOK_POST, ADS_CAMPAIGN, etc.
  status      String  @default("DRAFT") // DRAFT, REVIEW, APPROVED, SCHEDULED, PUBLISHED
  description String?

  // Media & Links
  mediaUrl String? // Optional main visual preview URL
  fileUrl  String? // Optional downloadable file path
  links    String? // Related URLs (e.g., live link)

  publishDate DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  creatorId String?
  creator   User?   @relation("ContentCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([publishDate])
}

model Employee {
  id        String    @id @default(uuid())
  name      String
  position  String
  salary    Float
  frequency String    @default("MONTHLY") // MONTHLY
  status    String    @default("ACTIVE") // ACTIVE, INACTIVE, LEAVE
  startDate DateTime
  endDate   DateTime?
  email     String?
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id               String  @id @default("default")
  name             String  @default("Nova Partners")
  logoUrl          String?
  logoDarkUrl      String?
  primaryColor     String  @default("#6366f1") // Indigo-500 default
  sidebarColor     String? // Custom sidebar background color
  sidebarTextColor String? // Custom sidebar unselected text color
  borderRadius     String  @default("0.5rem") // Global border radius

  // Meta (Facebook) Integration
  metaAccessToken  String? // Long-lived access token (encrypted)
  metaTokenExpiry  DateTime?
  metaConnectedAt  DateTime?

  updatedAt DateTime @updatedAt
}

model Competitor {
  id          String  @id @default(uuid())
  name        String
  website     String?
  description String?

  // Ventajas competitivas
  competitiveAdvantages String? // Texto largo o JSON

  // Enlaces a anuncios
  metaAdsUrl   String? // Enlace a anuncios de Meta/Facebook
  googleAdsUrl String? // Enlace a anuncios de Google

  // Productos y servicios (JSON arrays)
  products String? // JSON: [{ name, price, description }]
  services String? // JSON: [{ name, price, description }]

  // Precios y ofertas
  pricing String? // JSON estructura de precios
  offers  String? // JSON de ofertas actuales

  // Relación con proyecto
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}
model AdReport {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Report metadata
  platform  String // META_ADS, GOOGLE_ADS, OTHER
  startDate DateTime
  endDate   DateTime

  // Metrics (all optional, user can fill what they have)
  reach       Int?
  impressions Int?
  clicks      Int?
  spend       Float?
  conversions Int?

  // Additional Metrics
  ctr         Float?
  cpc         Float?
  cpm         Float?
  cpa         Float?
  engagement  Int?
  videoViews  Int?
  
  // Selected metrics (to show even if empty)
  selectedMetrics Json? // Array of metric keys: ["reach", "spend", "ctr", "cpa"]

  // Content - Now using blocks
  title   String // Required report title
  content String? @db.Text // Deprecated, kept for backward compatibility

  // Audit
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  comments    AdReportComment[]
  blocks      AdReportBlock[]

  @@index([projectId])
  @@index([platform])
  @@index([startDate])
}

model AdReportBlock {
  id          String   @id @default(uuid())
  reportId    String
  report      AdReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  order       Int      // Display order
  title       String
  description String   @db.Text // Rich HTML content
  images      String[] // Array of image URLs
  files       Json?    // Array of file metadata { name, url, size, type }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reportId])
  @@index([order])
}


model AdReportComment {
  id        String   @id @default(uuid())
  reportId  String
  report    AdReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@index([userId])
}


// Social features for Bitácora
model UserMention {
  id String @id @default(uuid())
  actionLogId String
  actionLog ActionLog? @relation(fields: [actionLogId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([actionLogId, userId])
  @@index([userId])
}

model ActionLogReaction {
  id String @id @default(uuid())
  actionLogId String
  actionLog ActionLog @relation(fields: [actionLogId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String // LIKE, DISLIKE
  createdAt DateTime @default(now())
  
  @@unique([actionLogId, userId])
  @@index([actionLogId])
}

model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String // MENTION, REPLY, REACTION
  title String
  message String
  actionLogId String?
  actionLog ActionLog? @relation(fields: [actionLogId], references: [id], onDelete: Cascade)
  read Boolean @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId, read])
}
