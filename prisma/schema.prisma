generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id          String   @id @default(uuid())
  name        String
  logo        String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, LEAD
  website     String?
  industry    String?
  email       String?
  phone       String?
  
  // Billing Info
  taxId           String?
  company         String?
  billingAddress  String?
  billingEmail    String?
  paymentTerms    String? // e.g. "Net 30"

  projects    Project[]
  
  financialRecords FinancialRecord[]
  clientNotes      ClientNote[]
  
  // Finance Relations
  contracts        Contract[]
  transactions     Transaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
}

model Project {
  id        String   @id @default(uuid())
  name      String
  code      String?  // Custom project code/identifier (e.g., MO239)
  description String?
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status    String   @default("PLANNING") // PLANNING, IN_PROGRESS, REVIEW, COMPLETED, ON_HOLD
  priority  String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  startDate DateTime?
  dueDate   DateTime?
  budget    Float?
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actionLogs ActionLog[]
  workflows ProjectWorkflow[]
  milestones Milestone[]
  resources Resource[]
  transactions Transaction[]
  contents Content[]
}

model Task {
  id        String   @id @default(uuid())
  title     String
  description String?
  status    String   @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  priority  String   @default("MEDIUM")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?    @relation(fields: [assigneeId], references: [id])
  links     String?  // JSON string or comma separated URLs
  dueDate   DateTime?
  attachments String?  // JSON string of file URLs
  
  actionLogs ActionLog[] // Task-specific logs (Bitácora)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActionLog {
  id        String   @id @default(uuid())
  content   String
  type      String   @default("NOTE") // NOTE, TASK, MEETING, EMAIL, WARNING
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId    String?  // Optional for now until Auth is fully rigorous, but UI will use it
  user      User?    @relation(fields: [userId], references: [id])
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String?  // e.g., "Social Media", "SEO", "Web Dev"
  
  stages      WorkflowStage[]
  
  projects    ProjectWorkflow[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkflowStage {
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int      @default(0)
  
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  tasks       WorkflowTask[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkflowTask {
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int      @default(0)
  
  stageId     String
  stage       WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectWorkflow {
  id         String   @id @default(uuid())
  projectId  String
  workflowId String
  status     String   @default("ACTIVE")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, workflowId])
}

enum Role {
  SUPERADMIN
  PROJECT_MANAGER
  COLABORADOR
  CLIENTE
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  avatar    String?
  role      Role     @default(COLABORADOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actionLogs ActionLog[]
  tasks     Task[]
  createdContents Content[] @relation("ContentCreator")
  
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id])
}

model Milestone {
  id          String   @id @default(uuid())
  title       String
  description String?  // Rich text content
  date        DateTime
  mediaUrl    String?  // URL for image or video (external)
  filePath    String?  // Path for uploaded file
  type        String   @default("MILESTONE")
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Resource {
  id        String   @id @default(uuid())
  name      String
  type      String   // DRIVE, LINK, FILE, CREDENTIAL
  url       String?
  content   String?  // For credentials, notes
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinancialRecord {
  id          String   @id @default(uuid())
  amount      Float
  type        String   // PAYMENT, COMMITMENT, REFUND
  description String
  date        DateTime
  status      String   // PENDING, COMPLETED, OVERDUE, FACTURA_EMITIDA, FACTURA_PAGADA, etc.
  
  // Invoice Details
  invoiceNumber String?
  dueDate       DateTime?
  paymentDate   DateTime?
  
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClientNote {
  id        String   @id @default(uuid())
  content   String
  isImportant Boolean @default(false)
  
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

// Finance Module
model Account {
  id        String   @id @default(uuid())
  name      String   // e.g., "Banco de Chile - Cta Cte", "Caja Chica"
  type      String   // BANK, CASH, CREDIT
  balance   Float    @default(0)
  currency  String   @default("CLP")
  
  transactions Transaction[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  type        String   // INCOME, EXPENSE
  category    String   // e.g., "Software", "Office", "Salaries", "Client Payment"
  description String?
  date        DateTime @default(now())
  status      String   @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  
  // Tax Handling (Chile)
  taxAmount   Float?   @default(0) // IVA or Retention
  isTaxable   Boolean  @default(false)

  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  // Optional link to Client or Project
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contract {
  id          String   @id @default(uuid())
  title       String
  description String?
  amount      Float    // Monthly or Total amount
  frequency   String?  // MONTHLY, ONE_OFF, ANNUALLY
  
  startDate   DateTime
  endDate     DateTime?
  status      String   @default("ACTIVE") // ACTIVE, EXPIRED, TERMINATED
  
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  attachments String?  // JSON list of file URLs
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Content {
  id          String   @id @default(uuid())
  title       String
  type        String   // SEO, INSTAGRAM_POST, INSTAGRAM_STORY, INSTAGRAM_REEL, FACEBOOK_POST, ADS_CAMPAIGN, etc.
  status      String   @default("DRAFT") // DRAFT, REVIEW, APPROVED, SCHEDULED, PUBLISHED
  description String?
  
  // Media & Links
  mediaUrl    String?  // Optional main visual preview URL
  fileUrl     String?  // Optional downloadable file path
  links       String?  // Related URLs (e.g., live link)
  
  publishDate DateTime?
  
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  creatorId   String?
  creator     User?    @relation("ContentCreator", fields: [creatorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Employee {
  id          String   @id @default(uuid())
  name        String
  position    String
  salary      Float
  frequency   String   @default("MONTHLY") // MONTHLY
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, LEAVE
  startDate   DateTime
  endDate     DateTime?
  email       String?
  phone       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Organization {
  id            String   @id @default("default")
  name          String   @default("Nova Partners")
  logoUrl       String?
  logoDarkUrl   String?
  primaryColor  String   @default("#6366f1") // Indigo-500 default
  sidebarColor  String?  // Custom sidebar background color
  sidebarTextColor String? // Custom sidebar unselected text color
  borderRadius  String   @default("0.5rem") // Global border radius
  
  updatedAt     DateTime @updatedAt
}
